# Build the client-only SPA; no employee files are used as build inputs.
FROM node:22-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/scripts/prepare-engines.mjs frontend/scripts/patch-woff2.mjs ./scripts/
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Minimal account/settings server. No server-side conversion executables.
FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ORT_DISABLE_TELEMETRY=1 \
    DATA_DIR=/app/data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-client-only.txt ./
RUN pip install --no-cache-dir -r requirements-client-only.txt
COPY backend/ ./backend/
COPY --from=frontend /src/frontend/dist ./frontend/dist
COPY --chmod=755 docker/entrypoint.sh /app/entrypoint.sh
RUN rm -rf /app/backend/tests /app/backend/converters /app/backend/compressors /app/backend/services && mkdir -p /app/data && \
    useradd --uid 10001 --system --home /app --shell /usr/sbin/nologin transmute && \
    chown -R transmute:transmute /app/data && chmod -R a+rX /app/backend /app/frontend
USER 10001:10001
EXPOSE 3313
ENTRYPOINT ["/app/entrypoint.sh"]
LABEL org.opencontainers.image.source="https://github.com/BlueDragon4251/transmute-client"
LABEL org.opencontainers.image.description="Client-only Transmute: browser-side files, server-side accounts"
